SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=crm_seo
DB_USER=crm_seo
DB_PASSWORD=crm_seo_dev_pw
DB_HOST=localhost
DB_PORT=5432

LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional integrations — leave blank to keep the related feature off ---

# AI content brief generation (your own key from console.anthropic.com;
# billed to your own Anthropic account)
ANTHROPIC_API_KEY=

# Daily digest ("what should I work on today?" by email/Telegram).
# DIGEST_CHANNELS: comma-separated subset of "email,telegram".
DIGEST_CHANNELS=
DIGEST_EMAIL_TO=
DIGEST_TIME=08:00

# Email sending (only needed if DIGEST_CHANNELS includes "email"). Leaving
# EMAIL_BACKEND as the console backend prints emails to the backend's logs
# instead of sending them — fine for local dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=crm@example.com

# Telegram sending (only needed if DIGEST_CHANNELS includes "telegram").
# Create a bot with @BotFather to get the token; message the bot once, then
# fetch https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Search Console (a service-account JSON key file path; share the
# GSC property with that service account's email address)
GOOGLE_SERVICE_ACCOUNT_FILE=
